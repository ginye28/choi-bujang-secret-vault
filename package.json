{
  "name": "aleph-defense-starter",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-public.mjs",
    "test:r5": "node --test test/r5.test.mjs",
    "test:package": "node --test test/package-starter.test.mjs",
    "test:resource-ids": "node --test test/resource-ids.test.mjs",
    "bundle": "node scripts/bundle.mjs",
    "decider:test": "node scripts/decider-test.mjs",
    "detect:test": "node scripts/detect-test.mjs",
    "policy:diff": "node scripts/policy-restore.mjs diff",
    "policy:restore": "node scripts/policy-restore.mjs restore",
    "fixture:7": "node scripts/fixture-7.mjs",
    "xdr:run": "node scripts/xdr-run.mjs",
    "verify:all": "node scripts/verify-all.mjs",
    "checks:record": "node scripts/check-record.mjs",
    "test": "node --test test/public/p0-platform.test.mjs test/public/d1-policy.test.mjs test/public/d2-events.test.mjs test/public/d3-response.test.mjs test/public/d4-restore.test.mjs",
    "test:own": "node --test test/product/own.test.mjs",
    "test:all": "node --test test/public/*.test.mjs test/product/*.test.mjs",
    "test:d1":"node --test test/public/d1-policy.test.mjs",
    "test:d2": "node --test test/public/d2-events.test.mjs",
    "test:d3": "node --test test/public/d3-response.test.mjs",
    "test:d4": "node --test test/public/d4-restore.test.mjs",
    "start:local": "node scripts/serve-local.mjs",
    "events": "node tools/event-generator.mjs",
    "check:platform": "node scripts/platform-sums.mjs",
    "test:platform": "node --test test/platform/supabase-store-pages.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "jose": "6.2.12"
  }
}
